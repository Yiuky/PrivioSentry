# ==============================================================================
# PRIVIO SENTRY (SENTRY Redact) - configuration / configuração
# Copy to `.env` and adjust. Every variable is optional; the value shown is the
# code default unless noted. Lines starting with "#" are commented-out defaults.
# Copie para `.env` e ajuste. Todas as variáveis são opcionais; o valor mostrado é o
# padrão do código, salvo indicação. Linhas com "#" são padrões comentados.
# NEVER commit `.env` / NUNCA versione o `.env`.
# ==============================================================================

# --- Web service / Serviço web -------------------------------------------------
# Bind interface. Keep 127.0.0.1 unless you set API_TOKEN and know what you are doing.
# Interface de escuta. Mantenha 127.0.0.1; use 0.0.0.0 somente com API_TOKEN definido.
# APP_HOST=127.0.0.1
# APP_PORT=8001
# If set, every route requires it (header X-API-Token, cookie api_token or ?token=).
# Se definido, todas as rotas exigem o token (header X-API-Token, cookie api_token ou ?token=).
# API_TOKEN=
# Extra host names accepted in the Host/Origin headers when API_TOKEN is empty (anti DNS rebinding / CSRF).
# Loopback and APP_HOST are always accepted. "*" disables the check (not recommended).
# Nomes extras aceitos nos cabeçalhos Host/Origin quando não há API_TOKEN (proteção contra DNS rebinding e
# CSRF). Loopback e APP_HOST sempre valem. "*" desliga a checagem (não recomendado). Ex.: sentry.intranet
# ALLOWED_HOSTS=

# --- PII policy / Política de dados pessoais (docs/catalogo-pii.md) --------------------------------
# cpf_endereco (default/padrão) | lgpd_publicacao | lgpd_interno | gdpr | saude_hipaa
# POLICY_PROFILE=cpf_endereco
# Nomes de pessoa e filiação (GLiNER local, opcional): pip install -e ".[nomes]"
# NER_ENGINE=                  # gliner | vazio (desligado)

# --- OCR / leituras ----------------------------------------------------------------------------------
# Leitura extra somada às duas do Tesseract (opcional): pip install -e ".[ocr-extra]" (docs/benchmarks.md)
# OCR_EXTRA_ENGINE=            # rapidocr | vazio (desligado)

# --- Fila / Queue --------------------------------------------------------------------------------
# Quantos documentos processam ao mesmo tempo; os outros esperam "Na fila" (protege memória e CPU)
# MAX_PARALLEL_TASKS=2

# --- Local decision model / Decisor local (optional, docs/decisions.md) ------------------------
# Requires / Exige: pip install -e ".[laya]"
# DECISION_ENGINE=off          # laya | off
# DECISION_MODE=shadow         # shadow (observa) | assist (participa; só com perfil aprovado)
# LAYA_MODEL=convaiinnovations/laya-multilingual
# LAYA_DEVICE=cpu
# LAYA_REVISION=reviewed       # fixa os commits revisados do modelo
# LEARNING_ENABLED=0           # 1 = aprende com as correções do revisor (dados ficam nesta máquina)
# PRIVIO_LEARNING_DIR=./learning
# Maximum upload size in MB / Tamanho máximo de upload em MB
# MAX_UPLOAD_MB=500
# Where uploaded PDFs are stored / Onde os PDFs enviados são guardados (default: ./WEB_INPUT)
# PRIVIO_INPUT_DIR=
# Task state file (JSON) / Arquivo de estado das tarefas (default: ./tasks.json)
# PRIVIO_TASKS_FILE=
# Where per-task artifacts (page images, OCR, crops: contain PII) and final PDFs are written.
# Onde ficam os artefatos de cada tarefa (imagens, OCR, recortes: contêm PII) e os PDFs finais.
# (defaults: ./output and ./documentos_finais)
# PRIVIO_OUTPUT_DIR=
# PRIVIO_FINAL_DIR=

# --- Gatekeeper (optional on/off panel + reverse proxy) / Gatekeeper (painel opcional) ---
# GATEKEEPER_PORT=8000
# GATEKEEPER_STATE_FILE=

# --- PDF -> image conversion (phase 0) / Conversão PDF -> imagem ---------------
# Rendering DPI for full-page OCR. Higher = better small text, slower and heavier.
# DPI de renderização para o OCR da página inteira. Maior = melhor p/ texto pequeno, porém mais lento.
# BASE_DPI=300

# --- OCR (Tesseract) -----------------------------------------------------------
# Path to the tesseract binary if it is not on PATH. / Caminho do executável se não estiver no PATH.
#   Windows: C:\Program Files\Tesseract-OCR\tesseract.exe      Linux: /usr/bin/tesseract
# TESSERACT_PATH=
# Language(s), e.g. por, por+eng. Requires the matching traineddata. / Idioma(s) do OCR.
# TESSERACT_LANG=por
# Directory with *.traineddata (only if not the system default). / Pasta dos *.traineddata (se não for a padrão).
# TESSDATA_PREFIX=
# Page segmentation modes (PSM): full page / sparse text pass / small crops
# Modos de segmentação: página inteira / passe de texto esparso / micro-recortes
# TESSERACT_STD_PSM=3
# TESSERACT_SPARSE_PSM=
# TESSERACT_CROP_PSM=6

# --- AI server / Servidor de IA (docs/configuration.md) ------------------------
# Qualquer servidor pela API: ollama | openai (LM Studio, vLLM, llama.cpp, servidor da organização)
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434          # openai: inclua /v1, ex.: http://localhost:1234/v1
# AI_API_KEY=                                 # se o servidor exigir
# AI_VISION_MODEL=                            # padrão: OLLAMA_VISION_MODEL
# AI_VISION_TIMEOUT=600
# IA reserva (assume quando a principal cai; com AI_CROSS_CHECK=1 também confere cada página)
# AI_SECONDARY_PROVIDER=openai
# AI_SECONDARY_BASE_URL=http://localhost:1234/v1
# AI_SECONDARY_VISION_MODEL=qwen3.5-9b
# AI_SECONDARY_VISION_TIMEOUT=600
# Disjuntor: falhas seguidas que desligam um servidor e segundos até testar de novo (pela API)
# AI_BREAKER_FAILURES=3
# AI_BREAKER_COOLDOWN=120
# AI_RESET_EVERY=0                            # descarrega o modelo a cada N chamadas (0 = só no disjuntor)
# AI_CROSS_CHECK=0
# ADDRESS_PROMPT=                             # legado = pedido antigo de endereços

# --- Legacy Ollama variables / Variáveis antigas do Ollama (ainda aceitas) ------
# OLLAMA_API_URL=http://localhost:11434
# Text model (address discovery) and vision model (handwritten CPFs). Pull them first: `ollama pull <name>`.
# Modelo de texto (descoberta de endereços) e de visão (CPFs manuscritos). Baixe antes: `ollama pull <nome>`.
# OLLAMA_MODEL=llama3
# OLLAMA_VISION_MODEL=gemma4:e4b
# Timeouts in seconds before the fallback/fail-closed path / Timeouts em segundos
# OLLAMA_TEXT_TIMEOUT=300
# OLLAMA_VISION_TIMEOUT=600
# Max image side (px) sent to the vision model and context window (tokens, affects VRAM).
# Lado máximo (px) da imagem enviada ao modelo de visão e janela de contexto (tokens; afeta VRAM).
# AI_IMAGE_RESOLUTION=2048
# AI_CONTEXT_WINDOW=32768

# --- Geometric detector (YOLO) / Detector geométrico (YOLO) --------------------
# Sanitized signature detector shipped with the project. / Detector de assinaturas incluído no projeto.
# YOLO_MODEL_PATH=models/signature_stamp_detector.pt
# Padding (px) around each detected signature that the vision model inspects.
# Margem (px) em volta de cada assinatura inspecionada pelo modelo de visão.
# YOLO_CROP_PADDING=50

# --- Post-redaction verification / Verificação pós-tarja -----------------------
# 1 = also OCR pages without native text in the final PDF (recommended; slower). 0 disables OCR checks.
# 1 = faz OCR nas páginas sem texto nativo do PDF final (recomendado; mais lento).
# VERIFY_OCR=1
# DPI used by the verification OCR / DPI do OCR de verificação
# VERIFY_DPI=300

# --- Output quality and data retention / Qualidade de saída e retenção ---------
# Implemented by the pipeline in recent versions; see docs/configuration.md.
# Width in px and JPEG quality (1-95) of pages in the final raster PDF. / Largura e qualidade JPEG do PDF final.
# FINAL_IMAGE_WIDTH=1240
# FINAL_JPEG_QUALITY=75
# Delete artifacts of tasks older than N days at startup (0/empty = keep forever).
# Apaga artefatos de tarefas com mais de N dias na inicialização (0/vazio = nunca).
# RETENTION_DAYS=0

# --- Logging / Logs ------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG_LEVEL=INFO
