# Configuração do app no cluster (vira o ConfigMap privio-config). Tudo de docs/configuration.md vale aqui.
# O que for salvo pela tela Administração fica em /data/state/privio_settings.json (volume) e vale sobre isto.
APP_HOST=0.0.0.0
APP_PORT=8001
PRIVIO_TASKS_FILE=/data/state/tasks.json
PRIVIO_SETTINGS_FILE=/data/state/privio_settings.json
PRIVIO_DOC_TEMPLATES_DIR=/data/state/modelos_documento
PRIVIO_INPUT_DIR=/data/input
PRIVIO_OUTPUT_DIR=/data/output
PRIVIO_FINAL_DIR=/data/final
PRIVIO_LEARNING_DIR=/data/learning
PRIVIO_RUNTIME_DIR=/data/runtime
# IA em outro pod/servidor: o Service "ollama" deste pacote (nome sem ponto = rede local, sem liberação externa)
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=gemma4:e4b
AI_ALLOW_EXTERNAL=0
DOC_TEMPLATES=1
DOC_TEMPLATE_INSPECTION=agente
MAX_PARALLEL_TASKS=2
# Apaga tarefas antigas (e os arquivos) na subida do serviço. Decida a política da sua organização:
# RETENTION_DAYS=30
